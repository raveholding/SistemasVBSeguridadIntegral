# ═══════════════════════════════════════════════════════════════
#  Sistemas VB Seguridad Integral — Configuración del servidor
#  Vincular Business · WhatsApp (387) 4484132 · vincularbusiness@gmail.com
#  Copiar este archivo como ".env" y completar. El .env NUNCA se sube a GitHub.
# ═══════════════════════════════════════════════════════════════

BUSINESS_NAME=Mi Negocio
PORT=8080

# ── Grabador Dahua (los mismos datos que muestra la app DMSS) ──
# Número de serie (DMSS → dispositivo → "Número de serie")
CAM_SERIAL=
# Usuario y contraseña del dispositivo (DMSS → "Nombre de usuario" / "Contraseña")
CAM_USER=admin
CAM_PASS=
# IP local del grabador. "auto" = el servidor la busca solo en la red usando el número de serie.
CAM_HOST=auto
# Cantidad de canales/cámaras y sus nombres (en orden)
CAM_CHANNELS=4
CAM_NAMES=Puerta,Mostrador,Depósito,Vereda
# Opcional: limitar la búsqueda, ej. 192.168.1.0/24
CAM_SCAN=

# ── PINs (cambiarlos) ──
DOOR_PIN=2580
DURESS_PIN=9999
ADMIN_PIN=1234

# ── Cerradura ESP32 (dejar vacío = modo simulado) ──
# ESP32_URL=http://192.168.1.60
ESP32_URL=
# Mismo valor que TOKEN en el firmware
ESP32_TOKEN=
RELAY_MS=3000

# ── Alertas al celular del dueño por Telegram (gratis) ──
# 1) En Telegram hablar con @BotFather → /newbot → copiar el token
# 2) Mandarle cualquier mensaje al bot y abrir https://api.telegram.org/bot<TOKEN>/getUpdates → copiar "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Protección del panel en la red (recomendado) ──
PANEL_USER=
PANEL_PASS=

# ── Sistemas VB Seguridad v2: sector e inteligencia artificial (todo editable desde ★ Configuración) ──
# comercio | industria | campo | residencial
SECTOR=comercio
# 1 (por defecto) = el asistente de instalación se abre solo la primera vez que se entra a Administración.
# 0 = para instalaciones que ya estaban funcionando: no se abre solo (se puede abrir a mano desde Administración).
WIZARD_AUTO=1
# Filtro de fauna, viento y vegetación (siempre activo en campo)
RURAL_FILTER=0
ANALYTICS_MIN_CONF=55
PLATE_AUTO_OPEN=0
OCCUPANCY_MAX=0
STREAM_WATCHDOG=1

# ── Integraciones (opcional) ──
# Home Assistant / Frigate / Node-RED: mqtt://IP:1883 (o mqtts:// con TLS)
MQTT_URL=
MQTT_USER=
MQTT_PASS=
HA_DISCOVERY=1
FRIGATE_TOPIC=
# Webhooks para ERP / POS (URLs separadas por coma) y clave para firmarlos
WEBHOOK_URLS=
WEBHOOK_SECRET=
# Red de alerta vecinal: el mismo código (12+ caracteres) en cada vecino
COMMUNITY_TOPIC=
COMMUNITY_NAME=

# ── Cifrado AES-256 en disco de contraseñas, tokens y datos biométricos ──
# La clave maestra se crea sola en data/master.key (hacer copia de seguridad de esa carpeta).
SECRETS_ENCRYPT=1
