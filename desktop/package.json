{
  "name": "svb-seguridad-desktop",
  "productName": "Sistemas VB Seguridad Integral",
  "version": "2.3.0",
  "description": "Sistemas VB Seguridad Integral — panel de seguridad integral para Windows",
  "main": "main.js",
  "private": true,
  "author": "Vincular Business · Sistema VB <vincularbusiness@gmail.com>",
  "scripts": {
    "start": "electron .",
    "kiosk": "electron . --kiosk",
    "dist": "node ../server/scripts/get-go2rtc.js && electron-builder --win nsis"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.svb.seguridad",
    "productName": "Sistemas VB Seguridad Integral",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../index.html",
        "to": "svb/index.html"
      },
      {
        "from": "../manifest.webmanifest",
        "to": "svb/manifest.webmanifest"
      },
      {
        "from": "../sw.js",
        "to": "svb/sw.js"
      },
      {
        "from": "../assets",
        "to": "svb/assets"
      },
      {
        "from": "../firmware",
        "to": "svb/firmware"
      },
      {
        "from": "../server",
        "to": "svb/server",
        "filter": [
          "**/*",
          "!test/**",
          "!node_modules/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../assets/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sistemas VB Seguridad Integral"
    }
  }
}
